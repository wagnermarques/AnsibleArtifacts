#!/bin/bash
# ==============================================================================
# FZL Ansible Artifacts Suite - Command Runner & Management Tool
# Managed by Ansible - desktop-fzl-commands-setup.yml
# ==============================================================================

# Default configured repository directory
CONFIGURED_REPO_DIR="{{ ansible_artifacts_dir | default(playbook_dir ~ '/..') }}"

{% raw %}
# ------------------------------------------------------------------------------
# Terminal styling
# ------------------------------------------------------------------------------
if [ -t 1 ]; then
    C_RESET="\033[0m"
    C_BOLD="\033[1m"
    C_DIM="\033[2m"
    C_RED="\033[1;31m"
    C_GREEN="\033[1;32m"
    C_YELLOW="\033[1;33m"
    C_BLUE="\033[1;34m"
    C_MAGENTA="\033[1;35m"
    C_CYAN="\033[1;36m"
    C_WHITE="\033[1;37m"
else
    C_RESET=""
    C_BOLD=""
    C_DIM=""
    C_RED=""
    C_GREEN=""
    C_YELLOW=""
    C_BLUE=""
    C_MAGENTA=""
    C_CYAN=""
    C_WHITE=""
fi

# ------------------------------------------------------------------------------
# Helper: Find Repository Root
# ------------------------------------------------------------------------------
find_repo_dir() {
    # 1. Environment variable override
    if [ -n "$ANSIBLE_ARTIFACTS_DIR" ] && [ -d "$ANSIBLE_ARTIFACTS_DIR" ]; then
        echo "$ANSIBLE_ARTIFACTS_DIR"
        return 0
    fi

    # 2. Ascend from current working directory
    local curr="$PWD"
    while [ "$curr" != "/" ]; do
        if [ -d "$curr/playbooks" ] && [ -f "$curr/inventory/hosts.ini" ]; then
            echo "$curr"
            return 0
        fi
        curr="$(dirname "$curr")"
    done

    # 3. Configured repository path from Ansible
    if [ -d "$CONFIGURED_REPO_DIR" ] && [ -d "$CONFIGURED_REPO_DIR/playbooks" ]; then
        echo "$CONFIGURED_REPO_DIR"
        return 0
    fi

    # 4. Standard developer locations fallback
    for candidate in \
        "$HOME/WORKING/Projects-Srcs/Projects-Srcs-FzlSoft/AnsibleArtifacts" \
        "/home/wgn/WORKING/Projects-Srcs/Projects-Srcs-FzlSoft/AnsibleArtifacts" \
        "$HOME/AnsibleArtifacts" \
        "/opt/AnsibleArtifacts"; do
        if [ -d "$candidate/playbooks" ]; then
            echo "$candidate"
            return 0
        fi
    done

    echo -e "${C_RED}Error:${C_RESET} Could not locate AnsibleArtifacts repository directory." >&2
    echo "Please set ANSIBLE_ARTIFACTS_DIR or run from within the repository." >&2
    return 1
}

# ------------------------------------------------------------------------------
# Helper: Resolve Playbook Path
# ------------------------------------------------------------------------------
resolve_playbook() {
    local target="$1"
    local repo_dir="$2"
    local playbooks_dir="$repo_dir/playbooks"

    # Direct paths
    if [ -f "$target" ]; then
        echo "$target"
        return 0
    fi
    if [ -f "$repo_dir/$target" ]; then
        echo "$repo_dir/$target"
        return 0
    fi
    if [ -f "$playbooks_dir/$target" ]; then
        echo "$playbooks_dir/$target"
        return 0
    fi
    if [ -f "$playbooks_dir/${target}.yml" ]; then
        echo "$playbooks_dir/${target}.yml"
        return 0
    fi
    if [ -f "$playbooks_dir/${target}.yaml" ]; then
        echo "$playbooks_dir/${target}.yaml"
        return 0
    fi

    # Fuzzy/partial match
    local matches=()
    while IFS= read -r -d $'\0' pb; do
        local b
        b="$(basename "$pb" .yml)"
        b="$(basename "$b" .yaml)"
        if [[ "$b" == *"$target"* ]]; then
            matches+=("$pb")
        fi
    done < <(find "$playbooks_dir" -maxdepth 1 \( -name "*.yml" -o -name "*.yaml" \) -print0)

    if [ ${#matches[@]} -eq 1 ]; then
        echo "${matches[0]}"
        return 0
    elif [ ${#matches[@]} -gt 1 ]; then
        echo -e "${C_YELLOW}Ambiguous playbook name '${target}'. Matches found:${C_RESET}" >&2
        for m in "${matches[@]}"; do
            echo "  - $(basename "$m")" >&2
        done
        return 1
    fi

    echo -e "${C_RED}Error:${C_RESET} Playbook '${target}' not found in ${playbooks_dir}." >&2
    return 1
}

# ------------------------------------------------------------------------------
# Command: playbook-list
# ------------------------------------------------------------------------------
cmd_playbook_list() {
    local repo_dir
    repo_dir="$(find_repo_dir)" || return 1
    local filter=""
    local names_only=0
    local show_paths=0

    while [ $# -gt 0 ]; do
        case "$1" in
            --names-only|--raw|-r|-n)
                names_only=1
                ;;
            --paths|-p)
                show_paths=1
                ;;
            -h|--help)
                echo "Usage: fzl-ansible-artifacts--playbook-list [filter] [--names-only] [--paths]"
                echo "Lists all playbooks in the AnsibleArtifacts repository."
                return 0
                ;;
            *)
                filter="$1"
                ;;
        esac
        shift
    done

    local playbooks=()
    while IFS= read -r -d $'\0' file; do
        playbooks+=("$file")
    done < <(find "$repo_dir/playbooks" -maxdepth 1 \( -name "*.yml" -o -name "*.yaml" \) -print0 | sort -z)

    if [ ${#playbooks[@]} -eq 0 ]; then
        echo -e "${C_YELLOW}No playbooks found in $repo_dir/playbooks.${C_RESET}"
        return 0
    fi

    if [ $names_only -eq 1 ]; then
        for pb in "${playbooks[@]}"; do
            local base="$(basename "$pb")"
            local name="${base%.*}"
            if [ -z "$filter" ] || [[ "$name" =~ $filter ]]; then
                echo "$name"
            fi
        done
        return 0
    fi

    echo -e "${C_BOLD}Available Ansible Playbooks (${#playbooks[@]} in $(basename "$repo_dir")/playbooks):${C_RESET}"
    if [ -n "$filter" ]; then
        echo -e "${C_YELLOW}Filter active: matching '${filter}'${C_RESET}"
    fi
    echo ""

    printf "  %-46s %s\n" "PLAYBOOK NAME" "DESCRIPTION"
    printf "  %-46s %s\n" "----------------------------------------------" "----------------------------------------------------"

    local match_count=0
    for pb in "${playbooks[@]}"; do
        local base="$(basename "$pb")"
        local name="${base%.*}"

        # Extract first '- name:' line from playbook
        local desc
        desc="$(grep -E '^[[:space:]]*- name:' "$pb" 2>/dev/null | head -n 1 | sed -E 's/^[[:space:]]*- name:[[:space:]]*//' | tr -d '\r\n"' | tr -d "'")"
        [ -z "$desc" ] && desc="(No description provided)"

        if [ -n "$filter" ]; then
            if ! echo "$name $desc" | grep -qi "$filter"; then
                continue
            fi
        fi

        ((match_count++))
        if [ $show_paths -eq 1 ]; then
            printf "  ${C_CYAN}%-46s${C_RESET} %s ${C_DIM}(%s)${C_RESET}\n" "$name" "$desc" "$pb"
        else
            printf "  ${C_CYAN}%-46s${C_RESET} %s\n" "$name" "$desc"
        fi
    done

    echo ""
    echo -e "${C_DIM}Run:   fzl-ansible-artifacts--playbook-run <playbook-name> [ansible options]${C_RESET}"
    echo -e "${C_DIM}Check: fzl-ansible-artifacts--playbook-check <playbook-name>${C_RESET}"
}

# ------------------------------------------------------------------------------
# Command: playbook-run
# ------------------------------------------------------------------------------
cmd_playbook_run() {
    local repo_dir
    repo_dir="$(find_repo_dir)" || return 1

    if [ $# -eq 0 ] || [ "$1" = "-h" ] || [ "$1" = "--help" ]; then
        echo -e "${C_BOLD}Usage:${C_RESET} fzl-ansible-artifacts--playbook-run <playbook-name> [ansible-options...]"
        echo ""
        echo "Runs an Ansible playbook with intelligent defaults and automated path resolution."
        echo ""
        echo -e "${C_BOLD}Examples:${C_RESET}"
        echo "  fzl-ansible-artifacts--playbook-run devmachine-setup-all-features"
        echo "  fzl-ansible-artifacts--playbook-run iamachine-setup"
        echo "  fzl-ansible-artifacts--playbook-run devmachine-lsp-setup --check"
        echo "  fzl-ansible-artifacts--playbook-run deploy-catracas -e 'version=1.2.0'"
        echo ""
        echo -e "${C_BOLD}Notes:${C_RESET}"
        echo "  - Extensions (.yml) and 'playbooks/' prefix are optional."
        echo "  - Automatically selects inventory/hosts.ini if no -i is specified."
        echo "  - Automatically prompts for sudo (-K) if playbook requires become."
        echo "  - Automatically includes .vault_pass if found in repo or home."
        return 0
    fi

    local target="$1"
    shift

    local playbook_path
    playbook_path="$(resolve_playbook "$target" "$repo_dir")" || return 1

    local rel_playbook="${playbook_path#$repo_dir/}"

    # Analyze user-provided arguments
    local has_inventory=0
    local has_become_arg=0
    local has_vault_arg=0
    local user_args=("$@")

    for arg in "${user_args[@]}"; do
        case "$arg" in
            -i|--inventory|--inventory-file)
                has_inventory=1
                ;;
            -K|--ask-become-pass|-b|--become|--become-user|--connection=local)
                has_become_arg=1
                ;;
            --ask-vault-pass|--vault-password-file*|--vault-id*)
                has_vault_arg=1
                ;;
        esac
    done

    local run_args=()

    # 1. Default inventory if not specified
    if [ $has_inventory -eq 0 ] && [ -f "$repo_dir/inventory/hosts.ini" ]; then
        run_args+=("-i" "inventory/hosts.ini")
    fi

    # 2. Vault password file detection
    if [ $has_vault_arg -eq 0 ]; then
        if [ -f "$repo_dir/.vault_pass" ]; then
            run_args+=("--vault-password-file" "$repo_dir/.vault_pass")
        elif [ -f "$HOME/.vault_pass" ]; then
            run_args+=("--vault-password-file" "$HOME/.vault_pass")
        fi
    fi

    # 3. Privilege escalation detection
    if [ $has_become_arg -eq 0 ] && [ "$EUID" -ne 0 ]; then
        # Check if playbook mentions become: (true|yes)
        if grep -qE '^[[:space:]]*become:[[:space:]]*(true|yes|1)' "$playbook_path" 2>/dev/null; then
            # Test if passwordless sudo is active
            if ! sudo -n true 2>/dev/null; then
                echo -e "${C_YELLOW}=> Playbook specifies become: true. Adding -K (--ask-become-pass)...${C_RESET}"
                run_args+=("-K")
            fi
        fi
    fi

    # Append remaining arguments from user
    run_args+=("${user_args[@]}")

    echo -e "${C_CYAN}=> Target Playbook:${C_RESET} ${C_BOLD}${rel_playbook}${C_RESET}"
    echo -e "${C_CYAN}=> Working Directory:${C_RESET} ${repo_dir}"
    echo -e "${C_CYAN}=> Executing:${C_RESET} ansible-playbook ${rel_playbook} ${run_args[*]}"
    echo ""

    # Execute from repository directory
    (
        cd "$repo_dir" || exit 1
        ansible-playbook "$rel_playbook" "${run_args[@]}"
    )
}

# ------------------------------------------------------------------------------
# Command: playbook-check (Syntax Check and Dry-Run)
# ------------------------------------------------------------------------------
cmd_playbook_check() {
    local repo_dir
    repo_dir="$(find_repo_dir)" || return 1

    local dry_run=0
    local target=""
    local user_args=()

    while [ $# -gt 0 ]; do
        case "$1" in
            --check|-C|--dry-run)
                dry_run=1
                ;;
            --all|-a)
                target="--all"
                ;;
            -h|--help)
                echo "Usage: fzl-ansible-artifacts--playbook-check [playbook-name|--all] [--check]"
                echo "Performs syntax validation and optional dry-run (--check) on playbooks."
                return 0
                ;;
            *)
                if [ -z "$target" ]; then
                    target="$1"
                else
                    user_args+=("$1")
                fi
                ;;
        esac
        shift
    done

    # If target is --all or empty, check all playbooks in repo
    if [ -z "$target" ] || [ "$target" = "--all" ]; then
        echo -e "${C_BOLD}Checking syntax across all playbooks in ${repo_dir}/playbooks...${C_RESET}"
        echo ""

        local total=0
        local passed=0
        local failed=0
        local failed_list=()

        while IFS= read -r -d $'\0' pb; do
            ((total++))
            local base="$(basename "$pb")"
            if ansible-playbook --syntax-check "$pb" >/dev/null 2>&1; then
                printf "  ${C_GREEN}✓ PASS${C_RESET}  %s\n" "$base"
                ((passed++))
            else
                printf "  ${C_RED}✗ FAIL${C_RESET}  %s\n" "$base"
                failed_list+=("$base")
                ((failed++))
            fi
        done < <(find "$repo_dir/playbooks" -maxdepth 1 \( -name "*.yml" -o -name "*.yaml" \) -print0 | sort -z)

        echo ""
        if [ $failed -eq 0 ]; then
            echo -e "${C_GREEN}${C_BOLD}✓ Syntax check successful:${C_RESET} All ${total} playbooks passed."
            return 0
        else
            echo -e "${C_RED}${C_BOLD}✗ Syntax check failed:${C_RESET} ${failed} of ${total} playbooks have errors."
            for err_pb in "${failed_list[@]}"; do
                echo -e "    - ${C_RED}${err_pb}${C_RESET} (run: ansible-playbook --syntax-check playbooks/${err_pb})"
            done
            return 1
        fi
    fi

    # Single playbook check
    local playbook_path
    playbook_path="$(resolve_playbook "$target" "$repo_dir")" || return 1
    local rel_playbook="${playbook_path#$repo_dir/}"

    echo -e "${C_CYAN}=> Running syntax check on:${C_RESET} ${rel_playbook}"
    (
        cd "$repo_dir" || exit 1
        ansible-playbook --syntax-check "$rel_playbook"
    ) || return $?

    echo -e "${C_GREEN}✓ Syntax check passed for ${rel_playbook}${C_RESET}"

    # Optional dry-run
    if [ $dry_run -eq 1 ]; then
        echo ""
        echo -e "${C_CYAN}=> Running dry-run check (--check) on:${C_RESET} ${rel_playbook}"
        cmd_playbook_run "$target" --check "${user_args[@]}"
    fi
}

# ------------------------------------------------------------------------------
# Command: vault-edit / vault-view / vault-encrypt / vault-decrypt
# ------------------------------------------------------------------------------
cmd_vault() {
    local action="$1"
    shift
    local repo_dir
    repo_dir="$(find_repo_dir)" || return 1

    local target_file="vars/vault.yml"
    local vault_args=()

    while [ $# -gt 0 ]; do
        case "$1" in
            -h|--help)
                echo "Usage: fzl-ansible-artifacts--vault-${action} [vault-file]"
                echo "Manages encrypted Ansible Vault files (default: vars/vault.yml)."
                return 0
                ;;
            -*)
                vault_args+=("$1")
                ;;
            *)
                target_file="$1"
                ;;
        esac
        shift
    done

    # Resolve target file path
    if [ ! -f "$target_file" ] && [ -f "$repo_dir/$target_file" ]; then
        target_file="$repo_dir/$target_file"
    fi

    # Detect vault password file
    if [ -f "$repo_dir/.vault_pass" ]; then
        vault_args+=("--vault-password-file" "$repo_dir/.vault_pass")
    elif [ -f "$HOME/.vault_pass" ]; then
        vault_args+=("--vault-password-file" "$HOME/.vault_pass")
    fi

    if [ "$action" = "decrypt" ]; then
        echo -e "${C_YELLOW}Warning: Decrypting will write plaintext secrets to disk.${C_RESET}"
        read -p "Are you sure you want to decrypt $target_file? (y/N): " -r confirm
        if [[ ! "$confirm" =~ ^[Yy]$ ]]; then
            echo "Operation cancelled."
            return 0
        fi
    fi

    echo -e "${C_CYAN}=> Ansible Vault ${action}:${C_RESET} ${target_file}"
    (
        cd "$repo_dir" || exit 1
        ansible-vault "$action" "${vault_args[@]}" "$target_file"
    )
}

# ------------------------------------------------------------------------------
# Command: inventory-list
# ------------------------------------------------------------------------------
cmd_inventory_list() {
    local repo_dir
    repo_dir="$(find_repo_dir)" || return 1

    local inv_file="$repo_dir/inventory/hosts.ini"
    if [ ! -f "$inv_file" ]; then
        echo -e "${C_RED}Error:${C_RESET} Inventory file not found at $inv_file" >&2
        return 1
    fi

    local inv_args=()
    local has_format=0

    while [ $# -gt 0 ]; do
        case "$1" in
            --graph|--list|--yaml)
                has_format=1
                inv_args+=("$1")
                ;;
            -h|--help)
                echo "Usage: fzl-ansible-artifacts--inventory-list [--graph|--list|--yaml|--host <hostname>]"
                echo "Displays inventory hosts and groups."
                return 0
                ;;
            *)
                inv_args+=("$1")
                ;;
        esac
        shift
    done

    # Default to --graph view for human readability
    if [ $has_format -eq 0 ]; then
        inv_args+=("--graph")
    fi

    echo -e "${C_BOLD}Inventory Hosts & Groups (${inv_file}):${C_RESET}"
    (
        cd "$repo_dir" || exit 1
        ansible-inventory -i "$inv_file" "${inv_args[@]}"
    )
}

# ------------------------------------------------------------------------------
# Command: doctor (Diagnostics)
# ------------------------------------------------------------------------------
cmd_doctor() {
    local repo_dir
    repo_dir="$(find_repo_dir 2>/dev/null)"

    echo -e "${C_BOLD}================================================================${C_RESET}"
    echo -e "${C_BOLD}      FZL Ansible Artifacts System Doctor & Diagnostics         ${C_RESET}"
    echo -e "${C_BOLD}================================================================${C_RESET}"
    echo ""

    # 1. Ansible Version
    if command -v ansible >/dev/null 2>&1; then
        local ans_ver
        ans_ver="$(ansible --version | head -n 1)"
        printf "  ${C_GREEN}✓ PASS${C_RESET}  Ansible Core:        %s\n" "$ans_ver"
    else
        printf "  ${C_RED}✗ FAIL${C_RESET}  Ansible Core:        Not installed or not in PATH!\n"
    fi

    # 2. Python Version
    if command -v python3 >/dev/null 2>&1; then
        local py_ver
        py_ver="$(python3 --version 2>&1)"
        printf "  ${C_GREEN}✓ PASS${C_RESET}  Python Runtime:      %s (%s)\n" "$py_ver" "$(command -v python3)"
    else
        printf "  ${C_RED}✗ FAIL${C_RESET}  Python Runtime:      Python 3 not found!\n"
    fi

    # 3. Repository Directory
    if [ -n "$repo_dir" ] && [ -d "$repo_dir" ]; then
        printf "  ${C_GREEN}✓ PASS${C_RESET}  Repository Root:     %s\n" "$repo_dir"
    else
        printf "  ${C_RED}✗ FAIL${C_RESET}  Repository Root:     Could not resolve repository location!\n"
    fi

    # 4. Git Status
    if [ -n "$repo_dir" ] && [ -d "$repo_dir/.git" ]; then
        local branch
        branch="$(git -C "$repo_dir" branch --show-current 2>/dev/null || echo "detached")"
        local uncommitted
        uncommitted="$(git -C "$repo_dir" status --porcelain 2>/dev/null | wc -l)"
        printf "  ${C_GREEN}✓ PASS${C_RESET}  Git Branch & Status: branch '%s', %s uncommitted file(s)\n" "$branch" "$uncommitted"
    else
        printf "  ${C_YELLOW}! WARN${C_RESET}  Git Tracking:        Not a git repository or .git missing.\n"
    fi

    # 5. Inventory
    if [ -n "$repo_dir" ] && [ -f "$repo_dir/inventory/hosts.ini" ]; then
        local host_count
        host_count="$(grep -cE '^[a-zA-Z0-9_-]+' "$repo_dir/inventory/hosts.ini" 2>/dev/null || echo "0")"
        printf "  ${C_GREEN}✓ PASS${C_RESET}  Inventory File:      %s/inventory/hosts.ini\n" "$repo_dir"
    else
        printf "  ${C_RED}✗ FAIL${C_RESET}  Inventory File:      inventory/hosts.ini missing!\n"
    fi

    # 6. Vault Files
    if [ -n "$repo_dir" ] && [ -f "$repo_dir/vars/vault.yml" ]; then
        if grep -q "ANSIBLE_VAULT" "$repo_dir/vars/vault.yml" 2>/dev/null; then
            printf "  ${C_GREEN}✓ PASS${C_RESET}  Vault Credentials:   vars/vault.yml is present and encrypted.\n"
        else
            printf "  ${C_YELLOW}! WARN${C_RESET}  Vault Credentials:   vars/vault.yml is unencrypted or template.\n"
        fi
    else
        printf "  ${C_YELLOW}! WARN${C_RESET}  Vault Credentials:   vars/vault.yml not found (check vars/vault-template.yml).\n"
    fi

    # 7. Vault Pass
    if [ -n "$repo_dir" ] && [ -f "$repo_dir/.vault_pass" ]; then
        printf "  ${C_GREEN}✓ PASS${C_RESET}  Vault Password:      %s/.vault_pass found.\n" "$repo_dir"
    elif [ -f "$HOME/.vault_pass" ]; then
        printf "  ${C_GREEN}✓ PASS${C_RESET}  Vault Password:      ~/.vault_pass found.\n"
    else
        printf "  ${C_DIM}- INFO${C_RESET}  Vault Password:      No .vault_pass file (ansible will ask with --ask-vault-pass).\n"
    fi

    # 8. Command symlinks
    local missing_symlinks=0
    for sym in fzl-ansible-artifacts--playbook-list fzl-ansible-artifacts--playbook-run fzl-ansible-artifacts--playbook-check; do
        if ! command -v "$sym" >/dev/null 2>&1; then
            ((missing_symlinks++))
        fi
    done
    if [ $missing_symlinks -eq 0 ]; then
        printf "  ${C_GREEN}✓ PASS${C_RESET}  FZL CLI Symlinks:    Installed in /usr/local/bin and active in PATH.\n"
    else
        printf "  ${C_YELLOW}! WARN${C_RESET}  FZL CLI Symlinks:    Some symlinks missing from PATH.\n"
    fi

    # 9. Playbooks count
    if [ -n "$repo_dir" ] && [ -d "$repo_dir/playbooks" ]; then
        local pb_count
        pb_count="$(find "$repo_dir/playbooks" -maxdepth 1 \( -name "*.yml" -o -name "*.yaml" \) | wc -l)"
        printf "  ${C_GREEN}✓ PASS${C_RESET}  Playbooks Available: %s playbooks in playbooks/\n" "$pb_count"
    fi

    echo ""
    echo -e "${C_DIM}Run 'fzl-ansible-artifacts--playbook-check --all' to test syntax on all playbooks.${C_RESET}"
}

# ------------------------------------------------------------------------------
# Command: docs (Browse & View Docs)
# ------------------------------------------------------------------------------
cmd_docs() {
    local repo_dir
    repo_dir="$(find_repo_dir)" || return 1

    local query="$1"

    if [ -z "$query" ]; then
        echo -e "${C_BOLD}Available AnsibleArtifacts Documentation:${C_RESET}"
        echo ""
        printf "  %-46s %s\n" "DOCUMENT" "PATH"
        printf "  %-46s %s\n" "----------------------------------------------" "----------------------------------------------------"

        if [ -f "$repo_dir/README.md" ]; then
            printf "  ${C_CYAN}%-46s${C_RESET} %s\n" "README.md" "$repo_dir/README.md"
        fi
        if [ -f "$repo_dir/AGENTS.md" ]; then
            printf "  ${C_CYAN}%-46s${C_RESET} %s\n" "AGENTS.md" "$repo_dir/AGENTS.md"
        fi

        while IFS= read -r -d $'\0' doc; do
            local base="$(basename "$doc")"
            printf "  ${C_CYAN}%-46s${C_RESET} %s\n" "$base" "$doc"
        done < <(find "$repo_dir/docs" -maxdepth 1 \( -name "*.org" -o -name "*.md" \) -print0 2>/dev/null | sort -z)

        echo ""
        echo -e "${C_DIM}To view a document: fzl-ansible-artifacts--docs <name-or-topic>${C_RESET}"
        return 0
    fi

    # Search for matching document
    local match=""
    if [ "$query" = "README" ] || [ "$query" = "README.md" ]; then
        match="$repo_dir/README.md"
    elif [ "$query" = "AGENTS" ] || [ "$query" = "AGENTS.md" ]; then
        match="$repo_dir/AGENTS.md"
    elif [ -f "$repo_dir/docs/$query" ]; then
        match="$repo_dir/docs/$query"
    elif [ -f "$repo_dir/docs/${query}.org" ]; then
        match="$repo_dir/docs/${query}.org"
    elif [ -f "$repo_dir/docs/${query}.md" ]; then
        match="$repo_dir/docs/${query}.md"
    else
        # Substring search in docs
        match="$(find "$repo_dir/docs" -maxdepth 1 \( -name "*${query}*.org" -o -name "*${query}*.md" \) 2>/dev/null | head -n 1)"
    fi

    if [ -n "$match" ] && [ -f "$match" ]; then
        echo -e "${C_CYAN}=> Viewing:${C_RESET} ${match}"
        if command -v bat >/dev/null 2>&1; then
            bat "$match"
        elif command -v less >/dev/null 2>&1; then
            less -R "$match"
        else
            cat "$match"
        fi
    else
        echo -e "${C_RED}Error:${C_RESET} No document matching '${query}' found."
        return 1
    fi
}

