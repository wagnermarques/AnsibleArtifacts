# ==============================================================================
# MAIN DISPATCHER
# ==============================================================================
INVOCATION_NAME="$(basename "$0")"

# 1. Determine subcommand from invocation name (e.g. symlink) or first argument
if [[ "$INVOCATION_NAME" =~ ^fzl-ansible-artifacts--(.*)$ ]]; then
    SUBCOMMAND="${BASH_REMATCH[1]}"
elif [[ "$INVOCATION_NAME" =~ ^fzl-playbook-(.*)$ ]]; then
    SUBCOMMAND="playbook-${BASH_REMATCH[1]}"
elif [[ "$INVOCATION_NAME" == "fzl-ansible" ]]; then
    if [ $# -gt 0 ]; then
        SUBCOMMAND="$1"
        shift
    else
        SUBCOMMAND="help"
    fi
elif [ $# -gt 0 ]; then
    SUBCOMMAND="$1"
    shift
else
    SUBCOMMAND="help"
fi

# 2. Dispatch
case "$SUBCOMMAND" in
    playbook-list|list|ls)
        cmd_playbook_list "$@"
        ;;
    playbook-run|run)
        cmd_playbook_run "$@"
        ;;
    playbook-check|check|syntax-check)
        cmd_playbook_check "$@"
        ;;
    vault-edit)
        cmd_vault "edit" "$@"
        ;;
    vault-view)
        cmd_vault "view" "$@"
        ;;
    vault-encrypt)
        cmd_vault "encrypt" "$@"
        ;;
    vault-decrypt)
        cmd_vault "decrypt" "$@"
        ;;
    inventory-list|inventory|hosts)
        cmd_inventory_list "$@"
        ;;
    doctor|health|diagnostics)
        cmd_doctor "$@"
        ;;
    docs|doc|manual)
        cmd_docs "$@"
        ;;
    dir|pwd|root)
        cmd_dir "$@"
        ;;
    version|-v|--version)
        cmd_version
        ;;
    help|-h|--help)
        cmd_help
        ;;
    *)
        echo -e "${C_RED}Unknown command:${C_RESET} $SUBCOMMAND" >&2
        echo "Run 'fzl-ansible-artifacts help' for available commands." >&2
        exit 1
        ;;
esac
