# ==============================================================================
# Shell-GPT (.sgptrc) configuration managed by Ansible
# ==============================================================================
DEFAULT_MODEL={{ sgpt_default_model | default('gpt-4o') }}
OPENAI_API_HOST={{ sgpt_openai_api_host | default('https://api.openai.com/v1') }}
{% if openai_api_key is defined and openai_api_key and openai_api_key != 'your_openai_api_key_here' %}
API_KEY={{ openai_api_key }}
{% endif %}
AUTO_SUGGESTIONS=true
SHELL=auto
CODE_THEME=monokai
SHOW_WARNS_FLAG=false
