{
  "mcpServers": {
    "github": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-github"
      ],
      "env": {
        "GITHUB_PERSONAL_ACCESS_TOKEN": "{{ github_mcp_token | default('') }}"
      }
    },
    "google-maps": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-google-maps"
      ],
      "env": {
        "GOOGLE_MAPS_API_KEY": "{{ google_maps_mcp_key | default('') }}"
      }
    },
    "brave-search": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-brave-search"
      ],
      "env": {
        "BRAVE_API_KEY": "{{ brave_search_mcp_key | default('') }}"
      }
    },
    "fetch": {
      "command": "npx",
      "args": [
        "-y",
        "mcp-server-fetch-typescript"
      ]
    },
    "sequential-thinking": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-sequential-thinking"
      ]
    }{% if install_ai_memory | default(true) %},
    "ai-memory": {
      "httpUrl": "http://127.0.0.1:{{ ai_memory_port | default(49374) }}/mcp",
      "timeout": 5000
    }{% endif %}
  }
}
