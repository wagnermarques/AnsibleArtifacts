#!/usr/bin/env bash
# Command wrapper for fzl-aider: runs aider within its dedicated virtual environment (~/.envs/aider)
# Supports local Ollama models and UNESP Pitia models (--pitia / fzl-aider-pitia)

VENV_DIR="${HOME}/.envs/aider"
if [ ! -d "$VENV_DIR" ]; then
    VENV_DIR="{{ real_user_home }}/.envs/aider"
fi

if [ ! -f "${VENV_DIR}/bin/activate" ]; then
    echo "Error: Virtual environment at ${VENV_DIR} not found." >&2
    exit 1
fi

source "${VENV_DIR}/bin/activate"

# Configuration defaults from Ansible
OLLAMA_DEFAULT_MODEL="{{ aider_default_model | default('ollama/qwen3.6:latest') }}"
PITIA_DEFAULT_MODEL_NAME="{{ pitia_default_model | default('gpt-5.6-Luna') }}"
PITIA_PROXY_PORT="{{ pitia_proxy_port | default(8787) }}"
PITIA_URL="{{ pitia_url | default('https://pitia.unesp.br') }}"
PITIA_TOKEN_FILE="${HOME}/.config/pitia/token"

# Detect if invoked as fzl-aider-pitia
IS_PITIA=0
case "$(basename "$0")" in
    *pitia*)
        IS_PITIA=1
        ;;
esac

DO_SELECT=0
DO_LIST=0
ARGS=()

for arg in "$@"; do
    case "$arg" in
        --pitia|-p)
            IS_PITIA=1
            ;;
        --select|-s|--choose)
            DO_SELECT=1
            ;;
        --list-models|-l)
            DO_LIST=1
            ;;
        *)
            ARGS+=("$arg")
            ;;
    esac
done

# Function to list available Ollama model tags
list_ollama_models() {
    if ! command -v ollama &>/dev/null; then
        echo "Error: Ollama CLI is not installed or not in PATH." >&2
        return 1
    fi
    ollama list 2>/dev/null | tail -n +2 | awk '{print $1}'
}

# Function to list available Pitia model IDs
list_pitia_models() {
    python3 -c "
import urllib.request, json, os, socket
orig = socket.getaddrinfo
socket.getaddrinfo = lambda h, p, f=0, t=0, pr=0, fl=0: orig(h, p, socket.AF_INET, t, pr, fl)

base = os.environ.get('OPENAI_API_BASE', '').rstrip('/')
key = os.environ.get('OPENAI_API_KEY', '')
url = f'{base}/models'
req = urllib.request.Request(url, headers={'Authorization': f'Bearer {key}'})
try:
    with urllib.request.urlopen(req, timeout=10) as r:
        data = json.loads(r.read().decode())
        for m in data.get('data', []):
            mid = m.get('id')
            if mid:
                print(mid)
except Exception:
    pass
"
}

if [ $IS_PITIA -eq 1 ]; then
    # Configure Pitia backend
    # Check if local pitia-proxy is listening
    if nc -z 127.0.0.1 "$PITIA_PROXY_PORT" 2>/dev/null || ss -ltn | grep -q ":${PITIA_PROXY_PORT} "; then
        export OPENAI_API_BASE="http://127.0.0.1:${PITIA_PROXY_PORT}/v1"
        export OPENAI_API_KEY="pitia-proxy"
    elif [ -s "$PITIA_TOKEN_FILE" ]; then
        export OPENAI_API_BASE="${PITIA_URL}/api"
        export OPENAI_API_KEY="$(cat "$PITIA_TOKEN_FILE")"
    else
        echo "Aviso: Token do Pitia não encontrado em ${PITIA_TOKEN_FILE} e pitia-proxy inativo." >&2
        echo "Execute: pitia-token login" >&2
    fi

    DEFAULT_MODEL="openai/${PITIA_DEFAULT_MODEL_NAME}"
    DEFAULT_MODEL_NAME="$PITIA_DEFAULT_MODEL_NAME"

    if [ $DO_LIST -eq 1 ]; then
        echo "Modelos disponíveis no Pitia UNESP:"
        list_pitia_models
        exit 0
    fi

    SELECTED_MODEL=""
    if [ $DO_SELECT -eq 1 ]; then
{% raw %}
        mapfile -t models < <(list_pitia_models)
        num_models=${#models[@]}
        if [ $num_models -eq 0 ]; then
            echo "Nenhum modelo retornado pelo Pitia." >&2
            echo "Usando modelo padrão: $DEFAULT_MODEL" >&2
            SELECTED_MODEL="$DEFAULT_MODEL"
        else
            default_idx=1
            for i in "${!models[@]}"; do
                if [ "${models[$i]}" == "$DEFAULT_MODEL_NAME" ]; then
                    default_idx=$((i+1))
                    break
                fi
            done

            echo "Modelos disponíveis no Pitia UNESP:"
            for i in "${!models[@]}"; do
                printf "  %2d) %s\n" "$((i+1))" "${models[$i]}"
            done
            read -r -p "Selecione o número do modelo [1-${num_models}] (padrão ${default_idx} - ${DEFAULT_MODEL_NAME}): " choice
            choice=${choice:-$default_idx}
            if [[ "$choice" =~ ^[0-9]+$ ]] && [ "$choice" -ge 1 ] && [ "$choice" -le "$num_models" ]; then
                idx=$((choice-1))
                SELECTED_MODEL="openai/${models[$idx]}"
                echo "Modelo selecionado: $SELECTED_MODEL"
            else
                echo "Seleção inválida. Usando ${DEFAULT_MODEL}."
                SELECTED_MODEL="$DEFAULT_MODEL"
            fi
        fi
{% endraw %}
    fi
else
    # Local Ollama backend
    export OLLAMA_API_BASE="${OLLAMA_API_BASE:-http://localhost:11434}"
    DEFAULT_MODEL="$OLLAMA_DEFAULT_MODEL"
    DEFAULT_MODEL_NAME="${DEFAULT_MODEL#ollama/}"

    if [ $DO_LIST -eq 1 ]; then
        echo "Installed local Ollama models:"
        if command -v ollama &>/dev/null; then
            ollama list
        else
            echo "Ollama CLI not found."
        fi
        exit 0
    fi

    SELECTED_MODEL=""
    if [ $DO_SELECT -eq 1 ]; then
{% raw %}
        mapfile -t models < <(list_ollama_models)
        num_models=${#models[@]}
        if [ $num_models -eq 0 ]; then
            echo "No local Ollama models found via 'ollama list'." >&2
            echo "Using default model: $DEFAULT_MODEL" >&2
            SELECTED_MODEL="$DEFAULT_MODEL"
        else
            default_idx=1
            for i in "${!models[@]}"; do
                if [ "${models[$i]}" == "$DEFAULT_MODEL_NAME" ]; then
                    default_idx=$((i+1))
                    break
                fi
            done

            echo "Available local Ollama models:"
            for i in "${!models[@]}"; do
                printf "  %2d) %s\n" "$((i+1))" "${models[$i]}"
            done
            read -r -p "Select a model number [1-${num_models}] (default ${default_idx} - ${DEFAULT_MODEL_NAME}): " choice
            choice=${choice:-$default_idx}
            if [[ "$choice" =~ ^[0-9]+$ ]] && [ "$choice" -ge 1 ] && [ "$choice" -le "$num_models" ]; then
                idx=$((choice-1))
                SELECTED_MODEL="ollama/${models[$idx]}"
                echo "Selected model: $SELECTED_MODEL"
            else
                echo "Invalid selection. Defaulting to ${DEFAULT_MODEL}."
                SELECTED_MODEL="$DEFAULT_MODEL"
            fi
        fi
{% endraw %}
    fi
fi

HAS_MODEL=0
for arg in "${ARGS[@]}"; do
    if [[ "$arg" == "--model" ]] || [[ "$arg" == --model=* ]]; then
        HAS_MODEL=1
        break
    fi
done

if [ -n "$SELECTED_MODEL" ]; then
    exec "${VENV_DIR}/bin/aider" --model "$SELECTED_MODEL" "${ARGS[@]}"
elif [ $HAS_MODEL -eq 0 ]; then
    exec "${VENV_DIR}/bin/aider" --model "$DEFAULT_MODEL" "${ARGS[@]}"
else
    exec "${VENV_DIR}/bin/aider" "${ARGS[@]}"
fi
