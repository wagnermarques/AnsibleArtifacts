# Android Development Environment
export ANDROID_HOME="{{ android_sdk_dir }}"
export ANDROID_SDK_ROOT="{{ android_sdk_dir }}"
export PATH="$PATH:{{ android_studio_dir }}/bin"
export PATH="$PATH:$ANDROID_HOME/cmdline-tools/latest/bin"
export PATH="$PATH:$ANDROID_HOME/platform-tools"
export PATH="$PATH:$ANDROID_HOME/emulator"

# Alias for starting Android Studio and viewing logs
alias fzl-android-studio-start='mkdir -p ~/.cache/android-studio && nohup {{ android_studio_dir }}/bin/studio.sh > ~/.cache/android-studio/studio.log 2>&1 &'
alias fzl-android-studio-logs='tail -f ~/.cache/android-studio/studio.log'

