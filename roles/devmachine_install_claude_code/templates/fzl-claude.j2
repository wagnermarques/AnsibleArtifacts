#!/usr/bin/env bash
# Command wrapper for fzl-claude: runs the natively installed Claude Code CLI

CLAUDE_BIN="${HOME}/.local/bin/claude"

if ! command -v claude &> /dev/null && [ ! -x "$CLAUDE_BIN" ]; then
    echo "Error: Claude Code is not installed or not in PATH." >&2
    echo "Please ensure the installation succeeded." >&2
    exit 1
fi

if command -v claude &> /dev/null; then
    exec claude "$@"
else
    exec "$CLAUDE_BIN" "$@"
fi
