{
  "mcpServers": {
    "github": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-github"
      ],
      "env": {
        "GITHUB_PERSONAL_ACCESS_TOKEN": "{{ effective_github_token }}"
      },
      "disabled": false,
      "autoApprove": []
    }{% if configure_ai_memory_mcp | default(true) %},
    "ai-memory": {
      "type": "http",
      "url": "{{ ai_memory_server_url | default('http://127.0.0.1:49374/mcp') }}",
      "disabled": false,
      "autoApprove": []
    }{% endif %}
  }
}
