{
  "mcpServers": {
    "github": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-github"
      ],
      "env": {
        "GITHUB_PERSONAL_ACCESS_TOKEN": "{{ effective_github_token }}"
      }
    }{% if configure_ai_memory_mcp | default(true) %},
    "ai-memory": {
      "command": "ai-memory",
      "args": [
        "serve",
        "--transport",
        "stdio"
      ]
    }{% endif %}
  }
}
